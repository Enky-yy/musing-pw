generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model views {
  slug  String @id
  count BigInt @default(1)
}

model guestbook {
  id         BigInt   @id @default(autoincrement())
  email      String
  body       String
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}
